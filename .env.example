# Local development environment for ProspectSoul.
#
#   cp .env.example .env
#
# Every value here is a DEVELOPMENT DEFAULT and is safe only on a developer
# machine. Never reuse these credentials outside local development, and never
# commit a filled-in .env.
#
# docker-compose.yml reads this file automatically. The backend does not — see
# "Backend environment" below for how to pass these to Spring Boot.

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=prospectsoul
POSTGRES_USER=prospectsoul
POSTGRES_PASSWORD=prospectsoul
POSTGRES_PORT=5432
# Separate database for Keycloak's own schema, created on first start.
KEYCLOAK_DB=keycloak

# --- Keycloak --------------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- MinIO -----------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=prospectsoul
MINIO_SECRET_KEY=prospectsoul
MINIO_BUCKET=prospectsoul

# --- Backend environment ---------------------------------------------------
# Read by backend/src/main/resources/application.yaml. Each has a development
# default in that file, so exporting them is optional locally.
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/prospectsoul
DATABASE_USERNAME=prospectsoul
DATABASE_PASSWORD=prospectsoul

KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/vyoog
KEYCLOAK_CLIENT_ID=prospectsoul-web

MINIO_ENDPOINT=http://localhost:9000

# Comma-separated exact origins. Never set this to "*" outside development.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The Spring AI OpenAI starter is on the classpath and needs a non-empty value
# to start. Leave the placeholder until AI work actually begins.
OPENAI_API_KEY=not-configured

# --- Frontend --------------------------------------------------------------
# The frontend reads frontend/.env.local, not this file. See
# frontend/.env.example.
