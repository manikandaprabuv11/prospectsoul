# Frontend development environment.
# Copy to .env.local and adjust. Never put secrets in VITE_* variables —
# everything prefixed with VITE_ is embedded into the browser bundle.

VITE_API_BASE_URL=http://localhost:8080/api/v1

VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=vyoog
VITE_KEYCLOAK_CLIENT_ID=prospectsoul-web

# Vite dev server port (defaults to 5173).
VITE_DEV_SERVER_PORT=5173
